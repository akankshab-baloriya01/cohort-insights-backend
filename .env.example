# Copy to .env for local (non-docker) runs. docker-compose.yml sets the storage URLs itself.

# --- service ---
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR (JSON lines on stdout)

# --- storage ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cohort_insights
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=0.5           # short, so a dead Redis degrades quickly instead of hanging requests

# --- per-user pipeline limit ---
MAX_ACTIVE_DOCS_PER_USER=3          # documents in queued/processing/enriching at once; beyond -> 429
ACTIVE_SLOT_TTL_SECONDS=900         # a slot not refreshed by a worker for this long is treated as leaked

# --- content cache ---
CONTENT_CACHE_TTL_SECONDS=86400     # Redis tier only; MongoDB results remain the durable second tier

# --- simulated pipeline ---
PROCESSING_MIN_SECONDS=10
PROCESSING_MAX_SECONDS=20
ENRICHING_MIN_SECONDS=5
ENRICHING_MAX_SECONDS=15
STAGE_FAILURE_RATE=0.10             # independent failure probability per stage attempt

# --- retries (per stage) ---
STAGE_MAX_ATTEMPTS=3                # 1 disables automatic retry
RETRY_BACKOFF_BASE_SECONDS=2        # delay ~ base * 2^(attempt-1), jittered, capped below
RETRY_BACKOFF_MAX_SECONDS=60

# --- worker ---
WORKER_CONCURRENCY=4                # stages one worker process runs concurrently
WORKER_POLL_INTERVAL_SECONDS=0.5
LEASE_SECONDS=60                    # must exceed the longest stage; expired leases are reclaimable

# --- pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
