# Copy to .env:  cp .env.example .env
# Docker Compose reads .env automatically. Every value here is optional; the defaults are shown.

# Host port the API is published on -> http://localhost:${API_PORT}
# Change it (e.g. 8001) if port 8000 is already in use on your machine.
API_PORT=8000

# Storage. Under Docker these default to the mongo/redis containers; set them only for
# non-Docker runs or to point at external servers.
# MONGO_URL=mongodb://localhost:27017
# MONGO_DB=cohort
# REDIS_URL=redis://localhost:6379/0

# Per-user limit and TTLs
MAX_ACTIVE_PER_USER=3
ACTIVE_KEY_TTL=3600
CACHE_TTL=86400

# Simulated pipeline
WORKER_COUNT=2
STAGE_TIME_SCALE=1
FAILURE_RATE=0.1
MAX_ATTEMPTS=3

LOG_LEVEL=INFO
